<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="create-playback-log-table" author="tuantu">
        <createTable tableName="playback_log">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ts" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="isrc_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="station_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="duration_seconds" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="listener_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="artist_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="track_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="rights_holder" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="listener_seconds" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>